# Fix: Ensure dependency caches are ignored anywhere they appear in the project tree
.cpcache/
**/.cpcache/

# --- REPL & tooling state ---
.nrepl-port
.nrepl-history
.rebel_readline_history
.socket-repl-port
.portal/
.calva/output-window/
.calva/repl.calva-repl

# --- clj-kondo / clojure-lsp caches ---
# Fix: Globally ignore all lsp and kondo cache trees no matter how deeply nested they get
.clj-kondo/.cache/
.clj-kondo/cache/
.lsp/.cache/
.lsp/cache/
sqlite*.db
**/.clj-kondo/
**/.lsp/

# --- Rendered output & Clay Artifacts ---
# Fix: Ignore hidden working files generated by Clay across the project tree
**/.clay.html

